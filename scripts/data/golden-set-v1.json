{
  "samples": [
    {"id": "qa-01", "task_type": "qa", "difficulty": "easy",
     "prompt": "中国的首都是哪座城市？",
     "accept": [{"type": "contains", "text": "北京"}],
     "expected": "北京"},
    {"id": "qa-02", "task_type": "qa", "difficulty": "easy",
     "prompt": "2 的 10 次方等于多少？",
     "accept": [{"type": "regex", "pattern": "\\b1024\\b"}],
     "expected": "1024"},
    {"id": "qa-03", "task_type": "qa", "difficulty": "medium",
     "prompt": "一个 300 米长的火车以 72 km/h 穿过 900 米隧道，从车头进到车尾出需要多少秒？",
     "accept": [{"type": "regex", "pattern": "\\b60\\b"}],
     "expected": "60 秒"},
    {"id": "qa-04", "task_type": "qa", "difficulty": "hard",
     "prompt": "解释什么是 MoE（Mixture of Experts）架构，并说明其与密集模型的核心区别。",
     "accept": [{"type": "contains", "text": "专家"}, {"type": "regex", "pattern": "(router|路由)"}],
     "expected": "专家网络 + 路由器稀疏激活"},
    {"id": "code-01", "task_type": "code", "difficulty": "easy",
     "prompt": "写一个 Python 函数 is_even(n)，返回 n 是否为偶数。",
     "accept": [{"type": "regex", "pattern": "def is_even"}, {"type": "regex", "pattern": "n\\s*%\\s*2"}],
     "expected": "def is_even(n): return n % 2 == 0"},
    {"id": "code-02", "task_type": "code", "difficulty": "easy",
     "prompt": "用 Python 一行代码求列表 [1,2,3,4,5] 的平方和。",
     "accept": [{"type": "regex", "pattern": "\\b55\\b"}],
     "expected": "sum(x*x for x in [1,2,3,4,5]) == 55"},
    {"id": "code-03", "task_type": "code", "difficulty": "medium",
     "prompt": "写一个 Python 函数，用二分查找在有序列表中查找目标值，返回索引或 -1。",
     "accept": [{"type": "regex", "pattern": "def (binary_search|bisect|search)"},
                {"type": "regex", "pattern": "(lo|low|left)\\s*(<|<=)\\s*(hi|high|right)"}],
     "expected": "二分查找函数，含左右指针"},
    {"id": "code-04", "task_type": "code", "difficulty": "medium",
     "prompt": "Python 中字典 dict 与 defaultdict 的区别是什么？各给出一个使用场景。",
     "accept": [{"type": "contains", "text": "defaultdict"},
                {"type": "contains", "text": "KeyError"}],
     "expected": "defaultdict 提供默认值工厂，dict 访问缺失键抛 KeyError"},
    {"id": "text-01", "task_type": "long-text", "difficulty": "easy",
     "prompt": "用一句话总结：FastAPI 是一个基于 Python 的现代 Web 框架，基于 ASGI，支持异步，自带 OpenAPI 文档生成，性能接近 Go。",
     "accept": [{"type": "contains", "text": "异步"}, {"type": "regex", "pattern": "(FastAPI|Web 框架|ASGI)"}],
     "expected": "FastAPI：Python 异步 Web 框架"},
    {"id": "text-02", "task_type": "long-text", "difficulty": "medium",
     "prompt": "给出一段 80 字以内的中文摘要：向量数据库用高维向量表示文本语义，通过相似度检索召回最相关片段，是 RAG 的核心组件；主流方案有 FAISS、Milvus、Qdrant。",
     "accept": [{"type": "contains", "text": "向量"}, {"type": "regex", "pattern": "(FAISS|Milvus|Qdrant)"}],
     "expected": "向量数据库 + 语义检索 = RAG 核心"},
    {"id": "text-03", "task_type": "long-text", "difficulty": "medium",
     "prompt": "总结 MoE 推理优化的三个关键点（缓存命中、thinking 预算、专家路由）。",
     "accept": [{"type": "regex", "pattern": "(缓存|cache)"}, {"type": "regex", "pattern": "(thinking|思维)"},
                {"type": "regex", "pattern": "(路由|router)"}],
     "expected": "三要点：稳定前缀缓存、按任务分级 thinking、结构化路由"},
    {"id": "ext-01", "task_type": "extraction", "difficulty": "easy",
     "prompt": "从这句话提取日期：项目将于 2026-08-22 完成验收。只输出日期。",
     "accept": [{"type": "regex", "pattern": "2026-08-22"}],
     "expected": "2026-08-22"},
    {"id": "ext-02", "task_type": "extraction", "difficulty": "medium",
     "prompt": "提取 JSON 中的邮箱和电话：{\"name\":\"张三\",\"email\":\"zhang@test.com\",\"phone\":\"13800138000\"}",
     "accept": [{"type": "contains", "text": "zhang@test.com"}, {"type": "contains", "text": "13800138000"}],
     "expected": "email + phone 都提取"},
    {"id": "ext-03", "task_type": "extraction", "difficulty": "medium",
     "prompt": "把这句话转成 JSON：{模型: deepseek-v4, 温度: 0.2, thinking: true}",
     "accept": [{"type": "regex", "pattern": "\\{\\s*\"model\"[^}]*\"temperature\"[^}]*\"thinking\""},
                {"type": "regex", "pattern": "(deepseek-v4|0\\.2)"}],
     "expected": "合法 JSON 含三个字段"},
    {"id": "ext-04", "task_type": "extraction", "difficulty": "hard",
     "prompt": "文本中出现了几个不同的股票代码？列出它们：上证 600519 收盘涨 2%，深市 000858 跌 1%，港股 00700 平盘。",
     "accept": [{"type": "regex", "pattern": "600519"}, {"type": "regex", "pattern": "000858"},
                {"type": "regex", "pattern": "00700"}],
     "expected": "三个代码全部列出"},
    {"id": "tool-01", "task_type": "tool-use", "difficulty": "easy",
     "prompt": "要查看当前目录下所有 .py 文件，应该用什么命令？",
     "accept": [{"type": "regex", "pattern": "(ls|glob|find).*py|(py).*(ls|glob)"}],
     "expected": "ls *.py / glob('*.py')"},
    {"id": "tool-02", "task_type": "tool-use", "difficulty": "easy",
     "prompt": "git 中查看工作区状态的命令是什么？",
     "accept": [{"type": "contains", "text": "git status"}],
     "expected": "git status"},
    {"id": "tool-03", "task_type": "tool-use", "difficulty": "medium",
     "prompt": "进程占用了 8080 端口，Windows 下如何找到并杀掉它？给出命令。",
     "accept": [{"type": "regex", "pattern": "(netstat|Get-NetTCPConnection)"},
                {"type": "regex", "pattern": "(taskkill|Stop-Process)"}],
     "expected": "netstat -ano 找 PID + taskkill"},
    {"id": "tool-04", "task_type": "tool-use", "difficulty": "medium",
     "prompt": "用 Python 标准库判断一个文件是否存在并打印其大小。",
     "accept": [{"type": "regex", "pattern": "from pathlib import Path|import os"},
                {"type": "regex", "pattern": "\\.exists\\(\\)"}],
     "expected": "pathlib.Path.exists() + stat().st_size"},
    {"id": "tool-05", "task_type": "tool-use", "difficulty": "hard",
     "prompt": "沙箱里 git push 需要先征得用户确认（SDK §10 纪律）。这条规则的本质是什么？用一句话回答。",
     "accept": [{"type": "contains", "text": "确认"}, {"type": "regex", "pattern": "(门禁|gate|人批|授权)"}],
     "expected": "外部副作用操作必须显式人批（tier-4 门）"}
  ]
}
